      "outputs": [],
      "source": [
        "notch_filter = \"semrock-nf03-405-488-561-635e\"\n",
        "dichroic_mirror = \"semrock-di03-r405-488-561-635-t1-25x36\"\n",
        "shortpass_filter = \"semrock-bsp01-785r\"\n",
