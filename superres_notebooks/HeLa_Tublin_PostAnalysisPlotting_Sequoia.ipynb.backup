{
  "cells": [
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "0f217e38",
      "metadata": {},
      "outputs": [],
      "source": [
        "import numpy as np  # import numerical python\n",
        "import matplotlib.pyplot as plt  # import plotting functions\n",
        "import seaborn as sns  # import nicer plotting functions\n",
        "import pandas as pd\n",
        "import polars as pl\n",
        "import tifffile as tiff\n",
        "from tifffile import imwrite, imread\n",
        "from copy import deepcopy\n",
        "import os\n",
        "import time\n",
        "from sklearn.cluster import DBSCAN, HDBSCAN\n",
        "\n",
        "import sys\n",
        "\n",
        "sys.path.append(\"..\")\n",
        "\n",
        "from src import IOFunctions\n",
        "\n",
        "IO = IOFunctions.IO_Functions()\n",
        "\n",
        "from src import Multicolour_Simulation_Functions\n",
        "\n",
        "MSF = Multicolour_Simulation_Functions.MultiC_Sim_Funcs()\n",
        "\n",
        "from src import PlottingFunctions\n",
        "\n",
        "plotter = PlottingFunctions.Plotter(dark_background=True)\n",
        "\n",
        "from src import ImageAnalysisFunctions\n",
        "\n",
        "I_AF = ImageAnalysisFunctions.Image_Analysis_Functions()\n",
        "\n",
        "from src import sCMOSFunctions\n",
        "\n",
        "sCMOS = sCMOSFunctions.sCMOS_Functions()\n",
        "\n",
        "from src import PSFFunctions\n",
        "\n",
        "PSF = PSFFunctions.PSF_Functions()\n",
        "\n",
        "from src import SpectralFunctions\n",
        "\n",
        "S_F = SpectralFunctions.Spectral_Funcs()\n",
        "\n",
        "from src import MaskFunctions\n",
        "\n",
        "M_F = MaskFunctions.Mask_Functions()\n",
        "\n",
        "from src import SpotDetectionFunctions\n",
        "\n",
        "SD_F = SpotDetectionFunctions.SpotDetection_Functions()\n",
        "\n",
        "from src import SR_Functions\n",
        "\n",
        "SRes_F = SR_Functions.SuperRes_Functions()\n",
        "\n",
        "from src import HelperFunctions\n",
        "\n",
        "H_F = HelperFunctions.Helper_Functions()\n",
        "\n",
        "import types\n",
        "\n",
        "smoothing_function = types.SimpleNamespace()\n",
        "smoothing_function.args = {\"sigma\": 1.5}\n",
        "smoothing_function.extent = 1.5\n",
        "smoothing_function.smoothing_function = sCMOS.gaussian_filter_stack\n",
        "smoothing_function.data_arg = \"image\""
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "0245988d-7d68-46e7-843d-aab26d8341e1",
      "metadata": {},
      "outputs": [],
      "source": [
        "# data_folder = '/home/jbeckwith/Documents/Cambridge University Dropbox/Joseph Beckwith/Chemistry/Lee/Data/Salix/CS505CU_Calibration/old/'\n",
        "data_folder = \"/home/jbeckwith/Documents/Cambridge University Dropbox/Joseph Beckwith/Chemistry/Lee/Data/Salix/Ximea_Calibration/\"\n",
        "# data_folder = r'C:\\Users\\jsb92\\Cambridge University Dropbox\\Joseph Beckwith\\Chemistry\\Lee\\Data\\Salix\\Ximea_Calibration'\n",
        "gain = IO.read_tiff(os.path.join(data_folder, \"gain.tif\"))\n",
        "offset = IO.read_tiff(os.path.join(data_folder, \"offset.tif\"))\n",
        "variance = IO.read_tiff(os.path.join(data_folder, \"variance.tif\"))\n",
        "readnoise = IO.read_tiff(os.path.join(data_folder, \"readnoise.tif\"))\n",
        "rqe = IO.read_tiff(os.path.join(data_folder, \"rqe.tif\"))\n",
        "R, G, B, wavelength = S_F.getpixelefficiency()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "29891a7b-7e32-4ea2-abf4-9e2560b14393",
      "metadata": {},
      "outputs": [],
      "source": [
        "data_folders = np.array(\n",
        "    [\n",
        "        r\"/media/jbeckwith/Ezra Seagat/JSB/20250523_HeLa_STORM/data/Cell4/\",\n",
        "        r\"/media/jbeckwith/Ezra Seagat/JSB/20250523_HeLa_STORM/data/Cell3/\",\n",
        "    ]\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "bcb5adde-9e15-474f-9389-86645fdd9828",
      "metadata": {},
      "outputs": [],
      "source": [
        "example_folder = data_folders[0]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "d489f003-ec33-4863-965f-6c0e721ebc5f",
      "metadata": {},
      "outputs": [],
      "source": [
        "localisation_files = H_F.file_search(example_folder, \".h5\", \"\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "60f43376-b63b-4f10-9b78-28b297d6fa6a",
      "metadata": {},
      "outputs": [],
      "source": [
        "columns = [\n",
        "    \"xc\",\n",
        "    \"yc\",\n",
        "    \"s_x\",\n",
        "    \"s_y\",\n",
        "    \"bg_B\",\n",
        "    \"bg_G\",\n",
        "    \"bg_R\",\n",
        "    \"A_B\",\n",
        "    \"A_G\",\n",
        "    \"A_R\",\n",
        "    \"chi_sqr\",\n",
        "    \"frame\",\n",
        "    \"xc_err\",\n",
        "    \"yc_err\",\n",
        "    \"s_x_err\",\n",
        "    \"s_y_err\",\n",
        "    \"bg_B_err\",\n",
        "    \"bg_G_err\",\n",
        "    \"bg_R_err\",\n",
        "    \"A_B_err\",\n",
        "    \"A_G_err\",\n",
        "    \"A_R_err\",\n",
        "]\n",
        "\n",
        "\n",
        "loc_data = pd.read_hdf(localisation_files[0])\n",
        "loc_data = loc_data[loc_data[\"xc_err\"] < 1]\n",
        "loc_data = loc_data[loc_data[\"yc_err\"] < 1]\n",
        "\n",
        "loc_data = loc_data[loc_data[\"xc_err\"] > 0]\n",
        "loc_data = loc_data[loc_data[\"yc_err\"] > 0]\n",
        "\n",
        "loc_data = loc_data[loc_data[\"A_B\"] + loc_data[\"A_G\"] + loc_data[\"A_R\"] < 10000]\n",
        "loc_data = loc_data[loc_data[\"A_B\"] + loc_data[\"A_G\"] + loc_data[\"A_R\"] > 500]\n",
        "loc_data = loc_data[loc_data[\"A_B\"] > 0]\n",
        "loc_data = loc_data[loc_data[\"A_G\"] > 0]\n",
        "loc_data = loc_data[loc_data[\"A_R\"] > 0]\n",
        "\n",
        "loc_data = loc_data[loc_data[\"chi_sqr\"] < 2]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "11541892-8ce6-416c-b0ec-d2a4564e47d7",
      "metadata": {},
      "outputs": [],
      "source": [
        "X = np.vstack([loc_data[\"xc\"], loc_data[\"yc\"]]).T\n",
        "loc_precision = 0.5 * (np.mean(loc_data[\"xc_err\"]) + np.mean(loc_data[\"yc_err\"]))\n",
        "hdb = DBSCAN(eps=loc_precision, min_samples=2000)\n",
        "hdb.fit(X)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "e55ebdbb-2c58-49bc-9413-fba0077550c9",
      "metadata": {},
      "outputs": [],
      "source": [
        "fiducial_1 = loc_data[loc_data[\"xc\"] > 100]\n",
        "fiducial_1 = fiducial_1[fiducial_1[\"xc\"] < 104]\n",
        "fiducial_1 = fiducial_1[fiducial_1[\"yc\"] < 404]\n",
        "fiducial_1 = fiducial_1[fiducial_1[\"yc\"] > 398]\n",
        "fiducial_1[\"xc\"] = fiducial_1[\"xc\"] * 69 - np.mean(\n",
        "    fiducial_1[\"xc\"].to_numpy()[0:200] * 69\n",
        ")\n",
        "fiducial_1[\"yc\"] = fiducial_1[\"yc\"] * 69 - np.mean(\n",
        "    fiducial_1[\"yc\"].to_numpy()[0:200] * 69\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "4f80970c-a115-4a87-806b-d749a9608e2f",
      "metadata": {},
      "outputs": [],
      "source": [
        "fiducial_2 = loc_data[loc_data[\"xc\"] > 520]\n",
        "fiducial_2 = fiducial_2[fiducial_2[\"xc\"] < 540]\n",
        "fiducial_2 = fiducial_2[fiducial_2[\"yc\"] < 160]\n",
        "fiducial_2 = fiducial_2[fiducial_2[\"yc\"] > 140]\n",
        "fiducial_2[\"xc\"] = fiducial_2[\"xc\"] * 69 - np.mean(\n",
        "    fiducial_2[\"xc\"].to_numpy()[0:200] * 69\n",
        ")\n",
        "fiducial_2[\"yc\"] = fiducial_2[\"yc\"] * 69 - np.mean(\n",
        "    fiducial_2[\"yc\"].to_numpy()[0:200] * 69\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "6e2a86cd-370d-4ba4-ad9d-f1b8c2a9094f",
      "metadata": {},
      "outputs": [],
      "source": [
        "fiducial_3 = loc_data[loc_data[\"xc\"] > 600]\n",
        "fiducial_3 = fiducial_3[fiducial_3[\"xc\"] < 620]\n",
        "fiducial_3 = fiducial_3[fiducial_3[\"yc\"] < 200]\n",
        "fiducial_3 = fiducial_3[fiducial_3[\"yc\"] > 180]\n",
        "fiducial_3[\"xc\"] = fiducial_3[\"xc\"] * 69 - np.mean(\n",
        "    fiducial_3[\"xc\"].to_numpy()[0:200] * 69\n",
        ")\n",
        "fiducial_3[\"yc\"] = fiducial_3[\"yc\"] * 69 - np.mean(\n",
        "    fiducial_3[\"yc\"].to_numpy()[0:200] * 69\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "9622dab1-df69-4221-8599-805267d93a15",
      "metadata": {},
      "outputs": [],
      "source": [
        "fiducial_4 = loc_data[loc_data[\"xc\"] > 730]\n",
        "fiducial_4 = fiducial_4[fiducial_4[\"xc\"] < 740]\n",
        "fiducial_4 = fiducial_4[fiducial_4[\"yc\"] < 200]\n",
        "fiducial_4 = fiducial_4[fiducial_4[\"yc\"] > 192]\n",
        "fiducial_4[\"xc\"] = fiducial_4[\"xc\"] * 69 - np.mean(\n",
        "    fiducial_4[\"xc\"].to_numpy()[0:200] * 69\n",
        ")\n",
        "fiducial_4[\"yc\"] = fiducial_4[\"yc\"] * 69 - np.mean(\n",
        "    fiducial_4[\"yc\"].to_numpy()[0:200] * 69\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "42e0eb96-4b51-47fe-8fc6-ba09c20a50b4",
      "metadata": {},
      "outputs": [],
      "source": [
        "smoother_x = np.full([4, int(np.max(loc_data[\"frame\"]))], np.NAN)\n",
        "smoother_y = np.full([4, int(np.max(loc_data[\"frame\"]))], np.NAN)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "c5f3ea6a-2f55-4d04-ac7a-d5cb30ca1f46",
      "metadata": {},
      "outputs": [],
      "source": [
        "for i in np.arange(int(np.max(loc_data[\"frame\"]))):\n",
        "    if np.isin(i, fiducial_1[\"frame\"]):\n",
        "        loc = np.argmin(np.abs(fiducial_1[\"frame\"].to_numpy() - i))\n",
        "        smoother_x[0, i] = fiducial_1[\"xc\"].to_numpy()[loc]\n",
        "        smoother_y[0, i] = fiducial_1[\"yc\"].to_numpy()[loc]\n",
        "    if np.isin(i, fiducial_2[\"frame\"]):\n",
        "        loc = np.argmin(np.abs(fiducial_2[\"frame\"].to_numpy() - i))\n",
        "        smoother_x[1, i] = fiducial_2[\"xc\"].to_numpy()[loc]\n",
        "        smoother_y[1, i] = fiducial_2[\"yc\"].to_numpy()[loc]\n",
        "    if np.isin(i, fiducial_3[\"frame\"]):\n",
        "        loc = np.argmin(np.abs(fiducial_3[\"frame\"].to_numpy() - i))\n",
        "        smoother_x[2, i] = fiducial_3[\"xc\"].to_numpy()[loc]\n",
        "        smoother_y[2, i] = fiducial_3[\"yc\"].to_numpy()[loc]\n",
        "    if np.isin(i, fiducial_4[\"frame\"]):\n",
        "        loc = np.argmin(np.abs(fiducial_4[\"frame\"].to_numpy() - i))\n",
        "        smoother_x[3, i] = fiducial_4[\"xc\"].to_numpy()[loc]\n",
        "        smoother_y[3, i] = fiducial_4[\"yc\"].to_numpy()[loc]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "2accf56c-b758-46fe-89cf-c276ab1e75e6",
      "metadata": {},
      "outputs": [],
      "source": [
        "smoother_x_avg = np.nanmean(smoother_x, axis=0)\n",
        "smoother_y_avg = np.nanmean(smoother_y, axis=0)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "b3ff02cf-cbdc-4460-9738-7eab151abca9",
      "metadata": {},
      "outputs": [],
      "source": [
        "def moving_average(a, n=3):\n",
        "    ret = np.nancumsum(a, dtype=float)\n",
        "    ret[n:] = ret[n:] - ret[:-n]\n",
        "    return ret[n - 1 :] / n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "cb91272a-851a-486b-85f5-1337b0f290b3",
      "metadata": {},
      "outputs": [],
      "source": [
        "loc_data_copy = deepcopy(loc_data)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "15d86165-ec6b-4091-b8ff-41ffffbe7f98",
      "metadata": {},
      "outputs": [],
      "source": [
        "photons = loc_data_copy[\"A_B\"] + loc_data_copy[\"A_G\"] + loc_data_copy[\"A_R\"]\n",
        "loc_data_copy = loc_data_copy[loc_data_copy[\"A_B\"] / photons > 1e-3]\n",
        "photons = loc_data_copy[\"A_B\"] + loc_data_copy[\"A_G\"] + loc_data_copy[\"A_R\"]\n",
        "loc_data_copy = loc_data_copy[loc_data_copy[\"A_G\"] / photons > 1e-3]\n",
        "photons = loc_data_copy[\"A_B\"] + loc_data_copy[\"A_G\"] + loc_data_copy[\"A_R\"]\n",
        "loc_data_copy = loc_data_copy[loc_data_copy[\"A_R\"] / photons > 1e-3]\n",
        "loc_data_copy = loc_data_copy[loc_data_copy[\"s_x\"] * 69 > 50]\n",
        "loc_data_copy = loc_data_copy[loc_data_copy[\"s_y\"] * 69 > 50]\n",
        "loc_data_copy = loc_data_copy[loc_data_copy[\"A_B_err\"] < 300]\n",
        "loc_data_copy = loc_data_copy[loc_data_copy[\"A_G_err\"] < 300]\n",
        "loc_data_copy = loc_data_copy[loc_data_copy[\"A_R_err\"] < 300]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "58703962-bb91-4e33-b192-0dd4ee5d3cdd",
      "metadata": {},
      "outputs": [],
      "source": [
        "photons = loc_data_copy[\"A_B\"] + loc_data_copy[\"A_G\"] + loc_data_copy[\"A_R\"]\n",
        "plt.hist(photons, 1000)\n",
        "# plt.xlim([0, 100])\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "6ce19259-45de-4bae-a57d-72e54c550417",
      "metadata": {},
      "outputs": [],
      "source": [
        "for i in np.arange(int(np.max(loc_data[\"frame\"]))):\n",
        "    loc_data_copy[loc_data_copy[\"frame\"] == i][\"xc\"] = (\n",
        "        loc_data_copy[loc_data_copy[\"frame\"] == i][\"xc\"] - smoother_x_avg[i] / 69\n",
        "    )\n",
        "    loc_data_copy[loc_data_copy[\"frame\"] == i][\"yc\"] = (\n",
        "        loc_data_copy[loc_data_copy[\"frame\"] == i][\"yc\"] - smoother_y_avg[i] / 69\n",
        "    )"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "04d4721d-0456-45c6-9f04-2a70590860bd",
      "metadata": {},
      "outputs": [],
      "source": [
        "test = loc_data_copy[loc_data_copy[\"s_y_err\"] * 69 < 40]\n",
        "test = test[test[\"s_x_err\"] * 69 < 40]\n",
        "test = test[test[\"A_B\"] + test[\"A_G\"] + test[\"A_R\"] < 5000]\n",
        "test = test[test[\"A_B\"] + test[\"A_G\"] + test[\"A_R\"] > 1000]\n",
        "plt.scatter(test[\"xc\"], test[\"yc\"], alpha=0.05, s=0.01)\n",
        "plt.xlim([0, 820])\n",
        "plt.ylim([0, 1250])\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "5491d8ee-f42b-4c24-8c8d-7ef69dcea736",
      "metadata": {},
      "outputs": [],
      "source": [
        "X = np.vstack([test[\"xc\"], test[\"yc\"]]).T\n",
        "loc_precision = 0.5 * (np.mean(test[\"xc_err\"]) + np.mean(test[\"yc_err\"]))\n",
        "hdb = DBSCAN(eps=loc_precision, min_samples=10)\n",
        "hdb.fit(X)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "e615cf68-9e34-4962-a32f-1fa1891ebbac",
      "metadata": {},
      "outputs": [],
      "source": [
        "test2 = test[hdb.labels_ < 0]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "af149138-0c29-495b-a53d-e23bebb4ef86",
      "metadata": {},
      "outputs": [],
      "source": [
        "from src import render\n",
        "\n",
        "locs, rendered_object = render.render(\n",
        "    test2.to_records(index=False),\n",
        "    viewport=((0, 0), (1250, 815)),\n",
        "    blur_method=\"gaussian\",\n",
        "    oversampling=2,\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "5fb2f261-348d-4819-9aec-ba56b2a2b8af",
      "metadata": {},
      "outputs": [],
      "source": [
        "fig, axs = plotter.two_column_plot()\n",
        "\n",
        "axs = plotter.image_plot(\n",
        "    axs=axs,\n",
        "    data=rendered_object.T,\n",
        "    vmin=np.percentile(rendered_object, 1),\n",
        "    vmax=np.percentile(rendered_object, 99.9),\n",
        "    cbar=\"on\",\n",
        "    cbarlabel=\"localisations\",\n",
        "    pixelsize=69 / 2,\n",
        ")\n",
        "import matplotlib.patches as patches\n",
        "\n",
        "rect = patches.Rectangle(\n",
        "    (900, 800), 300, 300, linewidth=0.5, edgecolor=\"white\", facecolor=\"none\"\n",
        ")\n",
        "\n",
        "# Add the patch to the Axes\n",
        "axs.add_patch(rect)\n",
        "\n",
        "plt.savefig(\"Exemplar_SuperRes_box.svg\", dpi=1200, format=\"svg\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "a49568b2-a534-41df-9d2a-b3710feac0fc",
      "metadata": {},
      "outputs": [],
      "source": [
        "fig, axs = plotter.one_column_plot()\n",
        "\n",
        "axs = plotter.image_plot(\n",
        "    axs=axs,\n",
        "    data=rendered_object.T[800:1100, 900:1200],\n",
        "    vmin=np.percentile(rendered_object, 1),\n",
        "    vmax=np.percentile(rendered_object, 99.9),\n",
        "    cbar=\"off\",\n",
        "    cbarlabel=\"localisations\",\n",
        "    pixelsize=69 / 2,\n",
        ")\n",
        "\n",
        "\n",
        "plt.savefig(\"Exemplar_SuperRes_Zoomin.svg\", dpi=1200, format=\"svg\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "cb8600fc-8b05-4aaf-ad6f-3cd83f417c60",
      "metadata": {},
      "outputs": [],
      "source": [
        "locs, rendered_object_nonSR = render.render(\n",
        "    test2.to_records(index=False),\n",
        "    viewport=((0, 0), (1250, 815)),\n",
        "    blur_method=\"gaussian\",\n",
        "    min_blur_width=3.3,\n",
        "    oversampling=2,\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "5bab7847-ec5b-47fc-a830-95376bfabb9d",
      "metadata": {},
      "outputs": [],
      "source": [
        "fig, axs = plotter.two_column_plot()\n",
        "\n",
        "axs = plotter.image_plot(\n",
        "    axs=axs,\n",
        "    data=rendered_object_nonSR.T,\n",
        "    vmin=np.percentile(rendered_object, 1),\n",
        "    vmax=np.percentile(rendered_object, 99.9),\n",
        "    cbar=\"on\",\n",
        "    cbarlabel=\"localisations\",\n",
        "    pixelsize=69 / 2,\n",
        ")\n",
